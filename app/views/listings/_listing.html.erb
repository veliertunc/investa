<div class="card card-border border border-gray-400 bg-base-100 w-96">
  <%= link_to listing_path(listing), class: "card-body p-4" do %>
    <div class="flex justify-between">
      <h3 class="card-title"><%= listing.title %></h3>
      <span class="<%= status_badge(listing.status) %> badge-soft">
        <%= listing.status.humanize %>
      </span>
    </div>
    
    <div class="space-y-4">
      <p><%= listing.startup.industry %></p>
      <p class="line-clamp-1"><%= listing.description %></p>
      
      <div class=" align-bottom mt-4 space-y-2">
        <div class="flex justify-between items-center text-sm">
          <span class="font-medium">Funding Goal</span>
          <span><%= number_to_currency(listing.funding_goal) %></span>
        </div>
        <div class="flex justify-between items-center text-sm">
          <span class="font-medium">Equity Offered</span>
          <span><%= listing.equity_offered %>%</span>
        </div>
      </div>
    </div>
  <% end %>
</div>
