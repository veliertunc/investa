<div class="max-w-7xl mx-auto">
  <h1 class="text-3xl font-bold mb-8">Investment Opportunities</h1>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% @listings.each do |listing| %>
      <div class="bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow">
        <%= link_to listing_path(listing), class: "block p-6" do %>
          <div class="flex justify-between items-start mb-4">
            <h3 class="text-xl font-semibold"><%= listing.title %></h3>
            <span class="<%= listing_status_color(listing.status) %> px-3 py-1 rounded-full text-sm">
              <%= listing.status.humanize %>
            </span>
          </div>
          
          <div class="space-y-2">
            <p class="text-gray-600"><%= truncate(listing.description, length: 100) %></p>
            <div class="flex justify-between items-center">
              <p class="font-medium">
                <%= number_to_currency(listing.funding_goal) %> goal
              </p>
              <p class="text-sm bg-gray-100 px-2 py-1 rounded">
                <%= listing.equity_offered %>% equity
              </p>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
