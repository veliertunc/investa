<div class="max-w-7xl mx-auto px-4 py-8">
  <div class="flex justify-between items-center">
    <h1 class="text-3xl font-bold mb-8">Investment Opportunities</h1>
    
  </div>

  <%= render 'search_form' %>

  <%# Pagination %>
  <div class="my-4">
    <%== pagy_nav(@pagy) if defined?(@pagy) %>
  </div>

  <% if @listings.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <%= render partial:'listing', collection: @listings %>
    </div>
  <% else %>
    <div class="text-center my-10">
      <p class="label">No listings found matching your criteria</p>
    </div>
  <% end %>

</div>
