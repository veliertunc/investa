<div class="bg-gray-50 p-4 rounded-lg mb-4">
  <div class="flex justify-between items-start mb-2">
    <p class="font-medium"><%= proposal.investor_profile.name %></p>
    <span class="text-sm text-gray-500">
      <%= time_ago_in_words(proposal.created_at) %> ago
    </span>
  </div>
  <p class="text-gray-600"><%= proposal.message %></p>
  <div class="mt-2 flex justify-between items-center">
    <div class="text-sm">
      <span class="font-medium">Amount:</span>
      <%= number_to_currency(proposal.amount) %>
    </div>
    <div class="text-sm">
      <span class="font-medium">Equity Requested:</span>
      <%= proposal.equity_requested %>%
    </div>
  </div>
</div>
