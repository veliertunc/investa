<%# app/views/listings/show.html.erb %>
<div class="max-w-4xl mx-auto px-4 py-8">
  <div class="bg-white rounded-lg shadow-md p-6">
    <div class="flex justify-between items-start mb-6">
      <div>
        <h1 class="text-3xl font-bold mb-2"><%= @listing.title %></h1>
        <p class="text-gray-600">Posted by <%= @listing.startup.name %></p>
      </div>
      <span class="<%= listing_status_color(@listing.status) %> px-4 py-2 rounded-full">
        <%= @listing.status.humanize %>
      </span>
    </div>

    <div class="space-y-6">
      <div class="prose max-w-none">
        <%= simple_format(@listing.description) %>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div class="bg-gray-50 p-4 rounded-lg">
          <p class="text-sm text-gray-500 mb-1">Funding Goal</p>
          <p class="text-2xl font-semibold">
            <%= number_to_currency(@listing.funding_goal) %>
          </p>
        </div>

        <div class="bg-gray-50 p-4 rounded-lg">
          <p class="text-sm text-gray-500 mb-1">Equity Offered</p>
          <p class="text-2xl font-semibold">
            <%= @listing.equity_offered %>%
          </p>
        </div>
      </div>

      <div class="mt-8">
        <h3 class="text-xl font-bold mb-4">Investment Proposals</h3>
        <% @listing.investment_proposals.each do |proposal| %>
          <%= render "proposal", proposal: proposal %>
        <% end %>
      </div>

      <% if current_user == @listing.startup.user %>
        <div class="flex gap-4 mt-8">
          <%= render 'favorites/button', favoritable: @listing %>
          <%= link_to 'Edit', edit_startup_listing_path(@listing.startup, @listing), 
                class: "btn btn-primary btn-md" %>
          <%= button_to 'Delete', startup_listing_path(@listing.startup, @listing),
                method: :delete,
                data: { confirm: 'Are you sure?' },
                class: "btn btn-danger btn-md" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
