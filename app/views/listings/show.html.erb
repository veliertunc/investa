<div class="max-w-4xl mx-auto p-6">
  <div class="card-body">
    <div class="flex justify-between mb-6">
      <div>
        <h1 class="text-3xl font-bold mb-2"><%= @listing.title %></h1>
        <p class="label">Posted by <%= @listing.startup.name %></p>
      </div>
      <span class="<%= status_badge(@listing.status) %> badge-soft">
        <%= @listing.status.humanize %>
      </span>
    </div>

    <div class="space-y-6">
      <div class="prose max-w-none">
        <%= simple_format(@listing.description) %>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div class="p-4 rounded-lg">
          <p class="label text-sm mb-1">Funding Goal</p>
          <p class="text-2xl font-semibold">
            <%= humanized_money_with_symbol(@listing.funding_goal) %>
          </p>
        </div>

        <div class="p-4 rounded-lg">
          <p class="label text-sm mb-1">Equity Offered</p>
          <p class="text-2xl font-semibold">
            <%= @listing.equity_offered %>%
          </p>
        </div>
      </div>

      <% if policy(@listing).list_proposals? %>
        <div class="mt-8">
          <% if @listing.investment_proposals.any? %>
            <h3 class="text-xl font-bold mb-4">Investment Proposals</h3>
            <% @listing.investment_proposals.each do |proposal| %>
              <%= render "proposal", proposal: proposal %>
            <% end %>
          <% else %>
            <div class="text-center py-4" >
              <p>You haven't received any proposal yet</p>
            </div>
          <% end %>
        </div>
      <% end %>

      <div class="card-actions justify-between">
        <div class="justify-start">
          <%= favorite_button(@listing) %>
        </div>

        <div class="justify-end">
          <%= link_to "View All", listings_path, class: "btn" %>

          <% if policy(InvestmentProposal).new? %>
            <%= link_to 'New Proposal', new_listing_investment_proposal_path(@listing), class: "btn btn-primary" %>
          <% end %>

          <% if policy(@listing).update? %>
            <%= link_to 'Edit', edit_startup_listing_path(@listing.startup, @listing), class: "btn btn-primary" %>
          <% end %>

          <% if policy(@listing).destroy? %>
            <%= button_to 'Delete', startup_listing_path(@listing.startup, @listing),
                  method: :delete,
                  data: { confirm: 'Are you sure?' },
                  class: "btn btn-error" %>
          <% end %>
        </div>
      </div>

    </div>
  </div>
</div>
