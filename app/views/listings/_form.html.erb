<%# app/views/listings/_form.html.erb %>
<%= form_with(model: [@startup, @listing]) do |form| %>
  <div class="space-y-6">
    <% if @listing.errors.any? %>
      <div class="bg-red-50 text-red-600 p-4 rounded-lg">
        <h2 class="font-medium"><%= pluralize(@listing.errors.count, "error") %> prohibited this listing from being saved:</h2>
        <ul class="list-disc pl-6 mt-2">
          <% @listing.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <fieldset class="fieldset w-xs bg-base-200 border border-base-300 p-4 rounded-box">
      <legend class="fieldset-legend">Listing info</legend>
      
      <%= form.label :title, class: "fieldset-label" %>
      <%= form.text_field :title, class: "input" %>
      
      <%= form.label :description, class: "fieldset-label" %>
      <%= form.text_area :description, class: "textarea" %>


      <%= form.label :funding_goal,"Funding goal", class: "fieldset-label" %>
      <label class="flex gap-2">
        <%= form.number_field :funding_goal, step: 0.01, min: 0.01, class: "input" %>
        <%= form.select :funding_goal_currency, Money::Currency.table.keys.map { |c| [c.to_s.upcase, c.to_s.upcase] }, { prompt: "Select a currency" }, class: "select max-w-fit" %>
      </label>

      <%= form.label :equity_offered, class: "fieldset-label" %>
      <label class="input">
        <%= form.number_field :equity_offered, step: 0.01, class: "grow" %>
        <span>%</span>
      </label>

      <div class="mt-4">
        <%= form.submit class: "btn btn-primary" %>
        <%= link_to 'Cancel', @listing.persisted? ? listing_path(@listing) : startup_path(@startup), 
          class: "btn" %>
      </div>
    </fieldset>
  </div>
<% end %>
