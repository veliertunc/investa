<%# app/views/listings/_form.html.erb %>
<%= form_with(model: [@startup, @listing]) do |form| %>
  <div class="space-y-6">
    <% if @listing.errors.any? %>
      <div class="bg-red-50 text-red-600 p-4 rounded-lg">
        <h2 class="font-medium"><%= pluralize(@listing.errors.count, "error") %> prohibited this listing from being saved:</h2>
        <ul class="list-disc pl-6 mt-2">
          <% @listing.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= form.label :title, class: "label" %>
      <%= form.text_field :title, class: "w-full text-field" %>
    </div>

    <div>
      <%= form.label :description, class: "label" %>
      <%= form.text_area :description, rows: 4, class: "w-full text-area" %>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= form.label :funding_goal, class: "label" %>
        <div class="relative">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500">$</span>
          <%= form.number_field :funding_goal, step: 0.01, class: "w-full pl-8 text-field" %>
        </div>
      </div>

      <div>
        <%= form.label :equity_offered, class: "label" %>
        <div class="relative">
          <%= form.number_field :equity_offered, step: 0.1, class: "w-full pr-8 text-field" %>
          <span class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-500">%</span>
        </div>
      </div>
    </div>

    <div>
      <%= form.label :status, class: "label" %>
      <%= form.select :status, Listing.statuses.keys.map { |s| [s.humanize, s] }, {}, class: "w-full text-field" %>
    </div>

    <div class="border-t pt-6">
      <%= form.submit class: "btn btn-primary" %>
      <%= link_to 'Cancel', @listing.persisted? ? listing_path(@listing) : startup_path(@startup), 
            class: "btn btn-secondary" %>
    </div>
  </div>
<% end %>
