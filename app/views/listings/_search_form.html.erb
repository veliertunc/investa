<div class="bg-white rounded-lg shadow p-6 mb-8">
  <%= search_form_for @q, class: "space-y-6" do |f| %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      <!-- Text Search -->
      <div>
        <%= f.label :title_or_description_cont, "Search", class: "block text-sm font-medium text-gray-700" %>
        <%= f.search_field :title_or_description_cont, class: "search-icon mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
      </div>

      <!-- Industry Select -->
      <div>
        <%= f.label :startup_industry_eq, "Industry", class: "block text-sm font-medium text-gray-700" %>
        <%= f.select :startup_industry_eq, Startup.pluck(:industry).uniq, { include_blank: true }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
      </div>

      <!-- Funding Range -->
      <div>
        <%= f.label :funding_goal_gteq, "Funding Range", class: "block text-sm font-medium text-gray-700" %>
        <div class="flex gap-2">
          <%= f.number_field :funding_goal_gteq, placeholder: "Min", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
          <%= f.number_field :funding_goal_lteq, placeholder: "Max", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
        </div>
      </div>

      <!-- Equity Offered -->
      <div>
        <%= f.label :equity_offered_gteq, "Equity Offered", class: "block text-sm font-medium text-gray-700" %>
        <%= f.range_field :equity_offered_gteq, min: 0, max: 100, class: "mt-1 block w-full", value: params.dig(:q, :equity_offered_gteq) %>
        <div class="flex justify-between text-sm text-gray-500">
          <span>0%</span>
          <span id="equity-display"><%= params.dig(:q, :equity_offered_gteq) || 0 %>%</span>
          <span>100%</span>
        </div>
      </div>
    </div>

    <!-- Status Filters -->
    <div class="border-t pt-4">
      <fieldset>
        <legend class="text-sm font-medium text-gray-700">Status</legend>
        <div class="mt-2 space-y-2">
          <% Listing.statuses.each do |status, value| %>
            <div class="flex items-center">
              <%= f.check_box :status_eq_any, { multiple: true, checked: params.dig(:q, :status_eq_any)&.include?(value.to_s) }, value, nil %>
              <%= f.label :status_eq_any, status.humanize, class: "ml-2 text-sm text-gray-600" %>
            </div>
          <% end %>
        </div>
      </fieldset>
    </div>

    <div class="flex justify-end gap-4 pt-6">
      <%= link_to "Clear", listings_path, class: "btn btn-secondary btn-sm" %>
      <%= f.submit "Search", class: "btn btn-primary btn-sm" %>
    </div>
  <% end %>
</div>

<script>
  // Update equity percentage display
  document.getElementById('q_equity_offered_gteq').addEventListener('input', function(e) {
    document.getElementById('equity-display').textContent = `${e.target.value}%`;
  });
</script>
