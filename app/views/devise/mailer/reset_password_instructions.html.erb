<%# app/views/devise/mailer/reset_password_instructions.html.erb %>
<div class="max-w-xl mx-auto p-6">
  <h1 class="text-2xl font-bold mb-4">Reset your password</h1>
  
  <p class="mb-4">Hello <%= @resource.email %>!</p>

  <p class="mb-4">Someone has requested a link to change your password. You can do this through the link below:</p>

  <p class="mb-4">
    <%= link_to "Change my password", edit_password_url(@resource, reset_password_token: @token), 
        class: "btn btn-primary" %>
  </p>

  <p class="text-sm text-gray-600">If you didn't request this, please ignore this email.</p>
</div>
