<fieldset class="fieldset w-xs bg-base-200 border border-base-300 p-4 rounded-box mx-auto">
  <legend class="fieldset-legend">Sign up</legend>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="space-y-4">
      <div>
        <%= f.label :email, class: "fieldset-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input" %>
      </div>

      <div>
        <%= f.label :password, class: "fieldset-label" %>
        <%= f.password_field :password, autocomplete: "new-password", class: "input " %>
        <% if @minimum_password_length %>
          <p class="validator-hint">(<%= @minimum_password_length %> characters minimum)</p>
        <% end %>
      </div>

      <div>
        <%= f.label :password_confirmation, class: "fieldset-label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input" %>
      </div>

      <div>
        <%= f.label :role, "Account Type", class: "label" %>
        <%= f.select :role, User.roles.keys.map { |role| [role.titleize, role] }, {}, class: "select" %>
      </div>

      <div>
        <%= f.submit "Sign up", class: "btn btn-primary w-full" %>
      </div>
    </div>
  <% end %>

  <div class="mt-4 text-center">
    <%= render "devise/shared/links" %>
  </div>
</fieldset>
