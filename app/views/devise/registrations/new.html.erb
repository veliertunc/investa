<%# app/views/devise/registrations/new.html.erb %>
<div class="max-w-md mx-auto my-10">
  <div class="bg-white shadow-sm rounded-lg p-8">
    <h2 class="text-2xl font-bold text-gray-800 mb-6">Sign up</h2>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="space-y-4">
        <div>
          <%= f.label :email, class: "label" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", 
                class: "text-field w-full" %>
        </div>

        <div>
          <%= f.label :password, class: "label" %>
          <%= f.password_field :password, autocomplete: "new-password",
                class: "text-field w-full" %>
          <% if @minimum_password_length %>
            <p class="mt-2 text-sm text-gray-500">(<%= @minimum_password_length %> characters minimum)</p>
          <% end %>
        </div>

        <div>
          <%= f.label :password_confirmation, class: "label" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password",
                class: "text-field w-full" %>
        </div>

        <div>
          <%= f.label :role, "Account Type", class: "label" %>
          <%= f.select :role, User.roles.keys.map { |role| [role.titleize, role] }, {},
                class: "text-field w-full" %>
        </div>

        <div>
          <%= f.submit "Sign up", 
                class: "w-full btn btn-primary btn-sm" %>
        </div>
      </div>
    <% end %>

    <div class="mt-6 text-center">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
