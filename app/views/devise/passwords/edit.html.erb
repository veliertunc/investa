<fieldset class="fieldset w-xs bg-base-200 border border-base-300 p-4 rounded-box mx-auto">
  <legend class="fieldset-legend">Change your password</legend>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>

    <div class="space-y-4">
      <%= f.label :password, "New password", class: "fieldset-label" %><br />
      <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "input" %>
      <% if @minimum_password_length %>
        <p class="validator-hint">(<%= @minimum_password_length %> characters minimum)</p>
      <% end %>
    </div>

    <div>
      <%= f.label :password_confirmation, "Confirm new password", class: "fieldset-label"  %><br />
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input" %>
    </div>

    <div>
      <%= f.submit "Change my password", class: "btn btn-link" %>
    </div>
  <% end %>

  <div class="mt-4 text-center">
    <%= render "devise/shared/links" %>
  </div>

</fieldset
