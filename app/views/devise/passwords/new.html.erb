<fieldset class="fieldset w-xs bg-base-200 border border-base-300 p-4 rounded-box mx-auto">
  <legend class="fieldset-legend">Forgot your password?</legend>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="space-y-4">
      <div>
        <%= f.label :email, class: "fieldset-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input" %>
      </div>

      <div>
        <%= f.submit "Send reset instructions", class: "btn btn-primary w-full" %>
      </div>
    </div>
  <% end %>

  <div class="mt-4 text-center">
    <%= render "devise/shared/links" %>
  </div>
</fieldset>
