<%# app/views/devise/shared/_links.html.erb %>
<%- if controller_name != 'sessions' %>
  <%= link_to "Log in", new_session_path(resource_name), class: "text-indigo-600 hover:text-indigo-900 text-sm font-medium" %>
<% end %>

<%- if devise_mapping.registerable? && controller_name != 'registrations' %>
  <span class="mx-2 text-gray-500">|</span>
  <%= link_to "Sign up", new_registration_path(resource_name), class: "text-indigo-600 hover:text-indigo-900 text-sm font-medium" %>
<% end %>

<%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
  <span class="mx-2 text-gray-500">|</span>
  <%= link_to "Forgot password?", new_password_path(resource_name), class: "text-indigo-600 hover:text-indigo-900 text-sm font-medium" %>
<% end %>
