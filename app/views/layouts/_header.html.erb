<header class="bg-white shadow-md">
  <nav class="bg-white shadow-lg" data-controller="mobile-menu">
    <div class="max-w-7xl mx-auto px-4">
      <div class="flex justify-between items-center h-16">
        <!-- Logo -->
        <div class="flex-shrink-0">
          <%= link_to root_path do %>
            <span class="text-2xl font-bold">Investa</span>
          <% end %>
        </div>

        <!-- Desktop Menu (hidden on mobile) -->
        <div class="hidden md:flex space-x-4">
          <%= link_to "Solutions", root_path, class: "nav-link" %>
          <%= link_to "Pricing", root_path, class: "nav-link" %>
          <%= link_to "Resources", root_path, class: "nav-link" %>
        </div>

        <!-- Mobile Menu Button -->
        <button class="md:hidden p-2 rounded-md hover:bg-gray-100 focus:outline-none"
                data-action="click->mobile-menu#toggle">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                  d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>

        <!-- Profile and Login/Logout -->
        <div class="hidden md:flex">
          <% if user_signed_in? %>
            <%= link_to 'Profile', edit_user_registration_path, class: "nav-link" %>
            <%= link_to "Logout", destroy_user_session_path, method: :delete, class: "nav-link" %>
          <% else %>
            <%= link_to "Login", new_user_session_path, class: "nav-link" %>
            <%= link_to "Sign Up", new_user_registration_path, class: "nav-link" %>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Mobile Menu (Hidden by default) -->
    <div class="md:hidden absolute w-full bg-white shadow-lg hidden" 
        data-mobile-menu-target="menu">
      <div class="px-4 py-2 space-y-2">
        <%= link_to "Home", root_path, class: "mobile-nav-link" %>
        <%= link_to "About", about_path, class: "mobile-nav-link" %>
          <% if user_signed_in? %>
            <%= link_to 'Profile', edit_user_registration_path, class: "mobile-nav-link" %>
            <%= link_to "Logout", destroy_user_session_path, method: :delete, class: "mobile-nav-link" %>
          <% else %>
            <%= link_to "Login", new_user_session_path, class: "mobile-nav-link" %>
            <%= link_to "Sign Up", new_user_registration_path, class: "mobile-nav-link" %>
          <% end %>
      </div>
    </div>
  </nav>

</header>
