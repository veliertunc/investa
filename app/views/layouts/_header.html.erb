<header class="shadow-lg h-20">
  <nav class="flex justify-between items-center px-6 py-4">
    <div class="flex items-center gap-6">
      <div class="text-2xl font-bold">
        <%= link_to "Investa", root_path %>
      </div>
      <div class="hidden md:flex gap-6 items-center">
        <% if user_signed_in? %>
          <%= link_to "Dashboard", dashboard_path, class: "nav-link" %>
          <%= link_to "Listings", listings_path, class: "nav-link" %>
          <% if current_user.investor? %>
            <%= link_to "Startups", startups_path, class: "nav-link" %>
            <%= link_to "Proposals", investment_proposals_path, class: "nav-link" %>
          <% elsif current_user.founder? %>
            <%= link_to "Investors", investor_profiles_path, class: "nav-link" %>
          <% end %>
        <% else %>
          <%= render "shared/dropdown",
            button_content: content_tag(:span, "Solutions", class: "nav-link"),
            menu_content: render("shared/solutions_menu") %>

          <%= link_to "Pricing", root_path, class: "nav-link" %>

          <%= render "shared/dropdown",
            button_content: content_tag(:span, "Resources", class: "nav-link"),
            menu_content: render("shared/resources_menu") %>
        <% end %>
      </div>
    </div>

    <div class="items-center">
      <%= render "shared/navbar_actions" %>
      <!-- Mobile Menu Button -->
      <%= render "shared/dropdown",
        icon_content: content_tag(:span,"•••", class: "md:hidden p-2 rounded-md hover:bg-gray-100 focus:outline-none ml-2"),
        menu_content: render("shared/mobile_menu") %>
    </div>
  </nav>
</header>
