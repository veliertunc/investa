<header class="bg-gray-800 shadow-md">
  <div class="container mx-auto px-4 flex justify-between items-center">
    <div class="text-lg text-white font-semibold">
      <!-- Desktop Menu -->
      <nav class="hidden md:flex space-x-4">
          <div class="flex justify-between h-16">
            <div class="flex items-center space-x-4">
              <!-- Logo -->
              <%= link_to "Investa", dashboard_path, class: "text-xl font-bold" %>
              <%= link_to "Solutions", "#", class: "btn" %>
              <%= link_to "Pricing", "#", class: "btn" %>
              <%= link_to "Resources", "#", class: "btn" %>
              <%= link_to "Startups", startups_path, class: "btn" %>
              <%= link_to "Listings", listings_path, class: "btn" %>
          </div>
          </div>
      </nav>
    </div>

    <!-- Mobile Menu Button -->
    <div class="md:hidden">
      <button id="mobile-menu-button" class="text-gray-800 focus:outline-none" data-action="click->mobile-menu#toggle">
        <svg class="w-6 h-6" fill="none" stroke="white" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
        </svg>
      </button>
    </div>


    <div class="hidden md:flex items-center space-x-4">
      <% if user_signed_in? %>
        <%= link_to 'Profile', edit_user_registration_path, class: "btn btn-sm" %>
        <%= button_to "Logout", destroy_user_session_path, method: :delete, class: "btn btn-danger btn-sm" %>
      <% else %>
        <%= link_to "Login", new_user_session_path, class: "btn btn-primary btn-sm" %>
        <%= link_to "Sign Up", new_user_registration_path, class: "btn btn-secondary btn-sm" %>
      <% end %>
    </div>

  </div>

  <!-- Mobile Menu (Hidden by Default) -->
  <div id="mobile-menu" class="md:hidden hidden bg-white" data-mobile-menu-target="menu">
    <div class="px-4 py-2 space-y-2">
      <%= link_to "Dashboard", dashboard_path, class: "block text-gray-800 hover:text-gray-600" %>
      <%= link_to "About", about_path, class: "block text-gray-800 hover:text-gray-600" %>
      <%= link_to "Contact", "#", class: "block text-gray-800 hover:text-gray-600" %>

      <% if user_signed_in? %>
        <%= link_to 'Profile', edit_user_registration_path, class: "block text-gray-800 hover:text-gray-600" %>
        <%= button_to "Logout", destroy_user_session_path, method: :delete, class: "block text-red-800 hover:text-red-600" %>
      <% else %>
        <%= link_to "Login", new_user_session_path, class: "block text-gray-800 hover:text-gray-600" %>
        <%= link_to "Sign Up", new_user_registration_path, class: "block text-gray-800 hover:text-gray-600" %>
      <% end %>
    </div>
  </div>

</header>
