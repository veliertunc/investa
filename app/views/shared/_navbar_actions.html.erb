  <div class="hidden md:flex space-x-2">
    <% if user_signed_in? %>
        <%= link_to 'Profile', edit_user_registration_path, class: "btn btn-md" %>
        <%= link_to "Logout", destroy_user_session_path, method: :delete, class: "btn btn-danger btn-md" %>
    <% else %>
        <%= link_to "Login", new_user_session_path, class: "btn btn-md" %>
        <%= link_to "Sign Up", new_user_registration_path, class: "btn btn-primary btn-md" %>
    <% end %>
  </div>
