<div class="max-w-3xl mx-auto rounded-lg shadow p-6">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-semibold text-gray-900"><%= @conversation.subject %></h1>
    <div class="space-x-2">
      <%= button_to "Trash", trash_conversation_path(@conversation), 
        method: :post, class: "btn btn-link btn-sm text-red-600" %>
    </div>
  </div>

  <div class="space-y-6">
    <%= render partial: "message", collection: @conversation.messages %>
  </div>

  <%= form_tag reply_conversation_path(@conversation), method: :post, class: "mt-8" do %>
    <div class="space-y-4">
      <%= text_area_tag :body, nil, rows: 3,
        class: "text-area w-full",
        placeholder: "Write your reply..." %>
      
      <%= submit_tag "Reply", 
        class: "btn btn-primary btn-md" %>
    </div>
  <% end %>
</div>
