<div class="flex flex-col h-screen w-full p-4">
  <!-- Header -->
  <div class="flex items-center justify-between h-20 sticky">
    <h2 class="text-lg font-semibold"><%= @conversation.subject %></h2>
    <%= button_to "Delete", trash_conversation_path(@conversation), 
      method: :post, class: "link link-error link-hover" %>
  </div>
  <!-- Chat History -->
  <div class="grow overflow-y-auto">
    <%= render partial: "message", collection: @conversation.messages %>
  </div>
  <!-- Reply Section -->
  <%= form_tag reply_conversation_path(@conversation), method: :post, class: "h-20 border-t" do %>
    <div class="flex items-center space-x-4 py-4">
        <%= text_field_tag :body, nil, class: "input grow", placeholder: "Write your reply..." %>
        <%= submit_tag "Reply", class: "btn btn-primary shrink-0" %>
    </div>
  <% end %>
</div>
