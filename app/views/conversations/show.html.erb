
<div class="w-full mx-auto px-4 bg-gray-400">
  <div class="py-4 flex justify-center items-center space-x-4" >
    <h1 class="text-2xl font-bold text-gray-800"><%= @conversation.subject %></h1>
  </div>
  <div class="space-y-4 py-4">
    <% @conversation.receipts_for(current_user).order(updated_at: :asc).each do |receipt| %>
      <div class="flex <%= receipt.message.sender == current_user ? "justify-start" : "justify-end" %>">
        <div class="chat-bubble text-white <%= receipt.message.sender == current_user ? "bg-blue-800" : "bg-gray-800"  %>">
          <%= receipt.message.body %>
        </div> 
      </div>
    <% end %>  
  </div>

  <%= form_tag conversation_messages_path(@conversation), method: :post do %>
    <div class="flex flex-row gap-4 py-4 w-full">
      <%= text_area_tag "message[body]", nil, class:"text-area w-full items-center" %>
      <%= submit_tag "Send", class: "btn btn-primary btn-md" %>
    </div>
  <% end %>

</div>
