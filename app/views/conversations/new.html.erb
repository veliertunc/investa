<div class="max-w-3xl mx-auto card">
  <h2 class="text-2xl font-semibold mb-6">New Message</h2>

  <%= form_tag conversations_path, method: :post do %>
    <div class="space-y-4">
      <% if @recipient %>
        <%= hidden_field_tag :recipient_id, @recipient.id %>
        <div class="p-3 bg-gray-50 rounded-lg">
          <p class="text-sm font-medium">To: <%= @recipient.name %></p>
        </div>
      <% else %>
        <div>
          <%= label_tag :recipient_id, "Recipient", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= select_tag :recipient_id, 
            options_from_collection_for_select(@recipients, :id, :email, params[:recipient_id]),
            class: "combo-box w-full" %>
        </div>
      <% end %>

      <div>
        <%= label_tag :subject, "Subject", class: "label" %>
        <%= text_field_tag :subject, nil, class: "text-field w-full" %>
      </div>

      <div>
        <%= label_tag :body, "Message", class: "label" %>
        <%= text_area_tag :body, nil, rows: 4, class: "text-field w-full" %>
      </div>

      <div class="mt-6">
        <%= submit_tag "Send Message", class: "btn btn-primary btn-md" %>
      </div>
    </div>
  <% end %>
</div>
