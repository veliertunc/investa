<div class="chat <%= message.sender == current_user ? 'chat-start' : 'chat-end' %>">
  <div class="chat-header">
    <%= message.sender.name %>
    <time class="text-xs opacity-50"><%= time_ago_in_words(message.created_at) %> ago</time>
  </div>

  <div class="chat-bubble">
    <%= sanitize message.body, tags: %w[strong em a], attributes: %w[href target] %>
  </div>
</div>
