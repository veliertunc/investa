<div class="<%= message.sender == current_user ? 'ml-8' : 'mr-8' %>">
  <div class="flex items-start gap-3">
    <div class="flex-shrink-0">
      <div class="h-8 w-8 rounded-full bg-gray-200 flex items-center justify-center">
        <%= message.sender.initials %>
      </div>
    </div>
    <div class="<%= message.sender == current_user ? 'bg-blue-50' : 'bg-gray-50' %> p-4 rounded-lg flex-1">
      <div class="flex justify-between items-center mb-2">
        <span class="font-medium text-gray-900"><%= message.sender == current_user ? "You" : message.sender.name %></span>
        <span class="text-sm text-gray-500"><%= time_ago_in_words(message.created_at) %> ago</span>
      </div>
      <p class="text-gray-700"><%= sanitize message.body, tags: %w[strong em a], attributes: %w[href target] %></p>
    </div>
  </div>
</div>
