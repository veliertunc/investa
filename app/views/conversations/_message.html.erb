<div class="<%= message.sender == current_user ? 'ml-8' : 'mr-8' %>">
  <div class="flex items-start gap-3">
    <div class="flex-shrink-0">
      <div class="h-8 w-8 rounded-full bg-gray-200 flex items-center justify-center">
        <%= message.sender.initials %>
      </div>
    </div>
    <div class="<%= message.sender == current_user ? 'bg-primary-100' : 'bg-base-100' %> p-4 rounded-lg flex-1">
      <div class="flex justify-between items-center mb-2">
        <span class="font-medium"><%= message.sender == current_user ? "You" : message.sender.name %></span>
        <span class="text-sm"><%= time_ago_in_words(message.created_at) %> ago</span>
      </div>
      <p ><%= sanitize message.body, tags: %w[strong em a], attributes: %w[href target] %></p>
    </div>
  </div>
</div>
