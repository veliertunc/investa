<div class="bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow">
  <%= link_to conversation_path(conversation), class: "block p-4" do %>
    <div class="flex justify-between items-start">
      <h3 class="text-xl font-semibold"><%= conversation.subject %></h3>
    </div>
    
    <div class="space-y-4">
      
      <div class="align-bottom mt-4 space-y-2">
        <div class="flex items-center text-sm">
          <p class="text-gray-800 text-sm mb-2"><%= conversation.last_sender.name %>: </p>
          <p class="text-gray-600 text-sm mb-2 mx-2 line-clamp-1"><%= conversation.last_message.body %></p>
        </div>
      </div>
    </div>
  <% end %>
</div>
