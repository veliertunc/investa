<%= form_with(model: [@listing, @proposal]) do |form| %>
  <div class="space-y-4">
    <% if @proposal.errors.any? %>
      <div class="bg-red-50 text-red-600 p-4 rounded-lg">
        <h2 class="font-medium"><%= pluralize(@proposal.errors.count, "error") %> prohibited this proposal from being saved:</h2>
        <ul class="list-disc pl-6 mt-2">
          <% @proposal.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <fieldset class="fieldset w-xs bg-base-200 border border-base-300 p-4 rounded-box">
      <legend class="fieldset-legend">Proposal details</legend>

      <%= form.label :amount, "Investment Amount", class: "fieldset-label" %>
      <label class="flex gap-2">
        <%= form.number_field :amount, step: 0.01, min: 0.01, class: "input" %>
        <%= form.select :amount_currency, Money::Currency.table.keys.map { |c| [c.to_s.upcase, c.to_s.upcase] }, { prompt: "Select a currency" }, class: "select max-w-fit" %>
      </label>

      <%= form.label :equity_requested, class: "fieldset-label" %>
      <%= form.number_field :equity_requested, step: 0.1, class: "input" %>

      <div class="mt-4 gap-4">
        <%= form.submit "Save", class: "btn btn-primary" %>

        <% if policy(InvestmentProposal).index? %>
          <%= link_to "View All", investment_proposals_path, class: "btn" %>
        <% end %>
      </div>
    </fieldset>
  </div>
<% end %>
