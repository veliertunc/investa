<div class="max-w-7xl mx-auto">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold">Investor Dashboard</h1>
    <div class="flex gap-4">
      <%= link_to 'Browse Listings', listings_path, class: "btn btn-primary" %>
      <%= link_to 'My Profile', investor_profile_path, class: "btn btn-secondary" %>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <div class="bg-white p-6 rounded-lg shadow">
      <h3 class="text-lg font-semibold mb-2">Active Opportunities</h3>
      <p class="text-2xl font-bold"><%= @listings.count %></p>
      <div class="mt-4">
        <%= link_to 'View All', listings_path, class: "text-indigo-600 hover:text-indigo-900" %>
      </div>
    </div>

    <div class="bg-white p-6 rounded-lg shadow">
      <h3 class="text-lg font-semibold mb-2">My Proposals</h3>
      <p class="text-2xl font-bold"><%= @proposals.count %></p>
      <div class="mt-4">
        <%= link_to 'View Proposals', '#', class: "text-indigo-600 hover:text-indigo-900" %>
      </div>
    </div>

    <div class="bg-white p-6 rounded-lg shadow">
      <h3 class="text-lg font-semibold mb-2">Notifications</h3>
      <p class="text-2xl font-bold"><%= @unread_notifications %></p>
      <div class="mt-4">
        <%= link_to 'View Notifications', notifications_path, class: "text-indigo-600 hover:text-indigo-900" %>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <h2 class="text-2xl font-bold mb-4">Recommended Listings</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <% @listings.each do |listing| %>
        <div class="border rounded-lg p-4 hover:bg-gray-50">
          <div class="flex justify-between items-start mb-2">
            <h3 class="font-semibold"><%= listing.title %></h3>
            <span class="<%= listing_status_color(listing.status) %> px-3 py-1 rounded-full text-sm">
              <%= listing.status.humanize %>
            </span>
          </div>
          <p class="text-gray-600 text-sm mb-2"><%= listing.startup.name %></p>
          <div class="flex justify-between items-center text-sm">
            <p><%= number_to_currency(listing.funding_goal) %> goal</p>
            <p><%= listing.equity_offered %>% equity</p>
          </div>
          <%= link_to 'View Details', listing_path(listing), class: "btn btn-secondary w-full mt-4" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
