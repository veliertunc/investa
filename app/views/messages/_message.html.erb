<%# app/views/messages/_message.html.erb %>
<div class="mb-4 <%= message.user == current_user ? 'text-right' : 'text-left' %>">
  <div class="inline-block max-w-[70%]">
    <div class="text-sm text-gray-500 mb-1">
      <%= message.user == current_user ? 'You' : message.user.email %>
      <span class="ml-2"><%= time_ago_in_words(message.created_at) %> ago</span>
    </div>
    <div class="<%= message.user == current_user ? 'bg-indigo-600 text-white' : 'bg-gray-100' %> rounded-lg p-3">
      <%= message.content %>
    </div>
  </div>
</div>
