<%# app/views/favorites/_button.html.erb %>
<% favorite = current_user.favorites.find_by(favoritable: favoritable) %>

<%= tag.div id: dom_id(favoritable), class: "favorite-button-container" do %>
  <% if favorite %>
    <%= button_to favorite_path(favorite), 
                  method: :delete, 
                  class: "btn btn-primary btn-md rounded-full transition-all duration-200 transform hover:scale-105 flex items-center gap-2 group" do %>
      <svg class="w-5 h-5 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
      </svg>
      <span class="group-hover:hidden">Favorited</span>
      <span class="hidden group-hover:inline">Unfavorite</span>
    <% end %>
  <% else %>
    <%= button_to favorites_path(favoritable_type: favoritable.class.name, favoritable_id: favoritable.id), 
                  class: "btn btn-md rounded-full transition-all duration-200 transform hover:scale-105 flex items-center gap-2 group" do %>
      <svg class="w-5 h-5 fill-current text-blue-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
        <path d="M22 9.24l-7.19-.62L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21 12 17.27 18.18 21l-1.63-7.03L22 9.24zM12 15.4l-3.76 2.27 1-4.28-3.32-2.88 4.38-.38L12 6.1l1.71 4.04 4.38.38-3.32 2.88 1 4.28L12 15.4z"/>
      </svg>
      <span>Favorite</span>
    <% end %>
  <% end %>
<% end %>

