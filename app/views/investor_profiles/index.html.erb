<% content_for :title, "Investor profiles" %>

<div class="w-full px-4">
  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Investor profiles</h1>
    <% if policy(InvestorProfile).new? %>
      <%= link_to "New investor profile", new_investor_profile_path, class: "btn btn-primary" %>
    <% end %>
  </div>

  <div id="investor_profiles" class="min-w-full space-y-4">
    <% if @investor_profiles.any? %>
      <%= render partial: "investor_profile", collection: @investor_profiles %>
    <% else %>
      <div class="text-center py-12">
        <p class="text-2xl">No investor profiles found.</p>
      </div>
    <% end %>
  </div>
</div>
