<%= form_with(model: investor_profile, class: "contents") do |form| %>
  <% if investor_profile.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(investor_profile.errors.count, "error") %> prohibited this investor_profile from being saved:</h2>

      <ul class="list-disc ml-6">
        <% investor_profile.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :name %>
    <%= form.text_field :name, class: ["text-field w-full", {"border-gray-400 focus:outline-blue-600": investor_profile.errors[:name].none?, "border-red-400 focus:outline-red-600": investor_profile.errors[:name].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :bio %>
    <%= form.textarea :bio, rows: 4, class: ["text-field w-full", {"border-gray-400 focus:outline-blue-600": investor_profile.errors[:bio].none?, "border-red-400 focus:outline-red-600": investor_profile.errors[:bio].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :investment_preferences %>
    <%= form.textarea :investment_preferences, rows: 4, class: ["text-field w-full", {"border-gray-400 focus:outline-blue-600": investor_profile.errors[:investment_preferences].none?, "border-red-400 focus:outline-red-600": investor_profile.errors[:investment_preferences].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit "Update", class: "btn btn-primary btn-md" %>
  </div>
<% end %>
