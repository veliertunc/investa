<%= form_with(model: investor_profile, class: "contents") do |form| %>
  <% if investor_profile.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(investor_profile.errors.count, "error") %> prohibited this investor_profile from being saved:</h2>

      <ul class="list-disc ml-6">
        <% investor_profile.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <fieldset class="fieldset w-xs bg-base-200 border border-base-300 p-4 rounded-box">
    <legend class="fieldset-legend">Profile info</legend>
    <%= form.hidden_field :user_id, value: current_user.id %>

    <%= form.label :name, class: "fieldset-label" %>
    <%= form.text_field :name, class: "input"  %>

    <%= form.label :bio, class: "fieldset-label" %>
    <%= form.textarea :bio, class: "textarea"  %>

    <%= form.label :investment_preferences, class: "fieldset-label" %>
    <%= form.textarea :investment_preferences, class: "textarea", placeholder: "Seperate your preferences with comma" %>

    <div class="mt-4">
      <%= form.submit "Save", class: "btn btn-primary" %>
    </div>
  </fieldset>
<% end %>
