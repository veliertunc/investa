<%# app/views/notifications/index.html.erb %>
<div class="max-w-3xl mx-auto">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold">Notifications</h1>
    <%= button_to "Mark all as read", mark_all_as_read_notifications_path, 
          method: :post, 
          class: "btn btn-secondary" %>
  </div>

  <div class="bg-white shadow rounded-lg divide-y">
    <% @notifications.each do |notification| %>
      <div class="p-4 <%= notification.unread? ? 'bg-blue-50' : 'bg-white' %>">
        <%= link_to notification.link, class: "block" do %>
          <div class="flex justify-between items-center">
            <div>
              <p class="<%= notification.unread? ? 'font-semibold' : 'text-gray-600' %>">
                <%= notification.message %>
              </p>
              <p class="text-sm text-gray-500">
                <%= time_ago_in_words(notification.created_at) %> ago
              </p>
            </div>
            <% if notification.unread? %>
              <span class="w-2 h-2 bg-blue-600 rounded-full"></span>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
