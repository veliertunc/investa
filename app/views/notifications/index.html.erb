<div class="max-w-7xl mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-4">
    <h1 class="text-3xl font-bold">Notifications</h1>
    <div class="flex gap-4">
      <%#<%= link_to 'Mark All as Read', mark_all_as_read_notifications_path, method: :post, class: 'btn btn-link btn-sm', data: { confirm: 'Are you sure you want to mark all notifications as read?' } %>
    </div>
  </div>

  <% if @notifications.any? %>
    <%= render partial: "notification", collection: @notifications %>
  <% else %>
     <p>You have no new notifications</p>
  <% end %>

</div>
