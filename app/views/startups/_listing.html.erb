<div class="bg-white rounded-lg shadow p-4">
  <h3 class="text-lg font-semibold"><%= listing.title %></h3>
  <p class="text-gray-600"><%= listing.description %></p>
  <div class="flex justify-between items-center mt-2">
    <span class="badge <%= listing_status_color(listing.status) %> px-2 py-1 rounded-full text-sm ">
      <%= listing.status.humanize %>
    </span>
    <%= link_to "View", listing_path(listing), class: "btn btn-secondary btn-sm" %>
  </div>
</div>
