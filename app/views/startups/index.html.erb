<% content_for :title, "Startups" %>

<div class="w-full px-8">

  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Startups</h1>
    <% if policy(Startup).new? %>
      <%= link_to "New Startup", new_startup_path, class: "btn btn-primary" %>
    <% end %>
  </div>

  <div id="startups" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 min-w-full gap-4 p-4">
    <% if @startups.any? %>
      <%= render partial: "startup", collection: @startups %>
    <% else %>
      <p class="text-center my-10">No startups found.</p>
    <% end %>
  </div>
</div>
