<div id="<%= dom_id startup %>">
  <div class="bg-white rounded-lg shadow p-6 mb-8">
    <h2 class="text-xl font-semibold mb-4">Company Details</h2>
    <p class="text-gray-600"><%= startup.description %></p>
    <div class="grid grid-cols-2 gap-4 mt-4">
      <div>
        <p class="font-medium">Industry:</p>
        <p><%= startup.industry %></p>
      </div>
      <div>
        <p class="font-medium">Funding Goal:</p>
        <p><%= number_to_currency(startup.funding_goal) %></p>
      </div>
    </div>
  </div>

  <h2 class="text-2xl font-bold mb-4">Your Listings</h2>
  <%= link_to "Create New Listing", new_listing_path, class: "btn btn-primary mb-4" %>
  
  <div class="space-y-4">
    <% startup.listings.each do |listing| %>
      <div class="bg-white rounded-lg shadow p-4">
        <h3 class="text-lg font-semibold"><%= listing.title %></h3>
        <p class="text-gray-600"><%= listing.description %></p>
        <div class="flex justify-between items-center mt-2">
          <span class="badge <%= listing_status_color(listing.status) %>">
            <%= listing.status.humanize %>
          </span>
          <%= link_to "View", listing_path(listing), class: "btn btn-secondary" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
