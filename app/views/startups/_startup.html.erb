<div id="<%= dom_id startup %>">
  <div class="bg-white rounded-lg shadow-md p-6">
    <h2 class="text-xl font-semibold mb-2"><%= startup.name %></h2>
    <p class="text-gray-600 text-sm mb-4"><%= truncate(startup.description, length: 100) %></p>
    <div class="flex justify-between items-center text-sm">
      <span class="bg-indigo-100 text-indigo-800 px-3 py-1 rounded-full"><%= startup.industry %></span>
      <%= link_to 'View', startup, class: "btn btn-secondary" %>
    </div>
  </div>
</div>
