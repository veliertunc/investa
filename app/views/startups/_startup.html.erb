<div id="<%= dom_id startup %>" class="card border border-gray-400 bg-base-200 w-96">
  <div class="card-body">
    <h2 class="card-title"><%= startup.name %></h2>
    <span class="badge badge-soft"><%= startup.industry %></span>
    <p><%= truncate(startup.description, length: 100) %></p>
    <div class="card-actions justify-end">
      <%= link_to 'View', startup, class: "btn btn-primary" %>
    </div>
  </div>
</div>
