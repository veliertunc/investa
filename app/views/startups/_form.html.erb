<%= form_with(model: @startup, class: "contents") do |form| %>
  <% if @startup.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(@startup.errors.count, "error") %> prohibited this startup from being saved:</h2>

      <ul class="list-disc ml-6">
        <% @startup.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <fieldset class="fieldset w-xs bg-base-200 border border-base-300 p-4 rounded-box">
    <legend class="fieldset-legend">Startup info</legend>

    <%= form.hidden_field :user_id, value: current_user.id %>

    <%= form.label :name, class: "fieldset-label" %>
    <%= form.text_field :name, class: "input" , placeholder: "Your Startup Ltd" %>

    <%= form.label :description, class: "fieldset-label" %>
    <%= form.text_area :description, class: "textarea" %>

    <%= form.label :industry, class: "fieldset-label" %>
    <%= form.text_field :industry, class: "input" %>

    <%= form.label :funding_goal, "Funding goal", class: "fieldset-label" %>
    <label class="flex gap-2">
      <%= form.number_field :funding_goal, step: 0.01, min: 0.01, class: "input" %>
      <%= form.select :funding_goal_currency, Money::Currency.table.keys.map { |c| [c.to_s.upcase, c.to_s.upcase] }, { prompt: "Select a currency" }, class: "select max-w-fit" %>
    </label>

    <%= form.label :equity_offered, class: "fieldset-label" %>
    <%= form.number_field :equity_offered, step: 0.01, class: "input" %>

    <%= form.label :url, class: "fieldset-label" %>
    <%= form.text_field :url, placeholder: "https://www.example.com", class: "input" %>

    <%= form.submit "Save", class: "btn btn-primary mt-4" %>
  </fieldset>
<% end %>
