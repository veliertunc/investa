<div class="max-w-4xl mx-auto">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold"><%= @startup.name %></h1>
    <%= link_to 'Edit', edit_startup_path(@startup), class: "btn btn-primary" %>
  </div>

  <div class="bg-white rounded-lg shadow-md p-6 mb-6">
    <div class="prose max-w-none">
      <%= simple_format(@startup.description) %>
    </div>

    <div class="grid grid-cols-2 gap-4 mt-6">
      <div class="bg-gray-50 p-4 rounded-lg">
        <p class="text-sm text-gray-500 mb-1">Funding Goal</p>
        <p class="text-2xl font-semibold"><%= number_to_currency(@startup.funding_goal) %></p>
      </div>
      <div class="bg-gray-50 p-4 rounded-lg">
        <p class="text-sm text-gray-500 mb-1">Equity Offered</p>
        <p class="text-2xl font-semibold"><%= @startup.equity_offered %>%</p>
      </div>
    </div>
  </div>

  <h2 class="text-2xl font-bold mb-4">Listings</h2>
  <%= render @startup.listings %>
</div>
