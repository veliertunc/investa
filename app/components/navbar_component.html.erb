<nav class="bg-white shadow-sm" data-controller="navbar">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 justify-between items-center">
      <!-- Logo -->
      <div class="flex-shrink-0">
        <%= link_to root_path, class: "text-xl font-bold text-gray-900 hover:text-gray-700" do %>
          Your Logo
        <% end %>
      </div>

      <!-- Desktop Menu -->
      <div class="hidden md:flex space-x-4 items-center">
        <%= render ButtonComponent.new(variant: :outline, size: :sm, class: "!no-underline") do %>
          <%= link_to "Home", dashboard_path %>
        <% end %>
        
        <%= render ButtonComponent.new(variant: :outline, size: :sm, class: "!no-underline") do %>
          About
        <% end %>

        <% if @user %>
          <%= render ButtonComponent.new(
            variant: :danger, 
            size: :sm, 
            data: { turbo_method: :delete },
            class: "!no-underline"
          ) do %>
            <%= link_to "Logout", destroy_user_session_path%>
          <% end %>
        <% else %>
          <%= render ButtonComponent.new(
            variant: :primary, 
            size: :sm, 
            class: "!no-underline"
          ) do %>
            <%= link_to "Login", new_user_session_path%>
          <% end %>
          <%= render ButtonComponent.new(
            variant: :secondary, 
            size: :sm, 
            class: "!no-underline"
          ) do %>
            <%= link_to "Sign Up", new_user_registration_path%>
          <% end %>
        <% end %>
      </div>

      <!-- Mobile Menu Button -->
      <%= render ButtonComponent.new(
        variant: :secondary,
        size: :sm,
        class: "md:hidden",
        data: { action: "click->navbar#toggleMenu" }
      ) do %>
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      <% end %>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div class="md:hidden hidden" data-navbar-target="mobileMenu">
    <div class="px-2 pt-2 pb-3 space-y-1">
      <%= render ButtonComponent.new(variant: :outline, size: :sm, class: "w-full !justify-start") do %>
          <%= link_to "Home", dashboard_path %>
      <% end %>
      
      <%= render ButtonComponent.new(variant: :outline, size: :sm, class: "w-full !justify-start") do %>
        About
      <% end %>

      <% if @user %>
        <%= render ButtonComponent.new(
          variant: :danger,
          size: :sm,
          class: "w-full !justify-start",
          data: { turbo_method: :delete }
        ) do %>
            <%= link_to "Logout", destroy_user_session_path%>
        <% end %>
      <% else %>
          <%= render ButtonComponent.new(
            variant: :primary,
            size: :sm,
            class: "w-full !justify-start",
          ) do %>
              <%= link_to "Login", new_user_session_path%>
          <% end %>
          <%= render ButtonComponent.new(
            variant: :secondary,
            size: :sm,
            class: "w-full !justify-start",
          ) do %>
              <%= link_to "Sign Up", new_user_registration_path%>
          <% end %>
      <% end %>
    </div>
  </div>
</nav>
