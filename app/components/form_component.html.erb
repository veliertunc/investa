<%= form_with(
  model: @model,
  url: @url,
  method: @method,
  class: "space-y-6"
) do |form| %>
  <% if @title %>
    <h3 class="text-2xl font-bold text-gray-900 mb-4"><%= @title %></h3>
  <% end %>
  
  <div class="space-y-4">
    <%= content %>
  </div>

  <div class="mt-6">
    <%= render ButtonComponent.new(type: :submit, variant: :primary, class: "w-full") do %>
      <%= @submit_text %>
    <% end %>
  </div>
<% end %>
